# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: bszf_hazi_bananfa
label: bszf_hazi_bananfa
description: |
  This example project shows an empty configuration that can be used as a starting point to add components and functionality.
category: Example|Platform
filter:
- name: Device Type
  value: [SoC]
- name: MCU
  value: [32-bit MCU]
- name: Project Difficulty
  value: [Beginner]
package: platform
quality: production
readme:
- {path: readme.md}
- {path: readme.md}
source:
- {path: app.c}
- {path: main.c}
include:
- path: .
  file_list:
  - {path: app.h}
sdk: {id: gecko_sdk, version: 4.4.6}
toolchain_settings: []
component:
- {id: EFM32GG990F1024}
- {id: brd2200a}
- {id: device_init}
- {id: efm32gg_stk3700}
- {id: emlib_acmp}
- {id: emlib_ebi}
- {id: emlib_lcd}
- {id: emlib_lesense}
- {id: emlib_rtc}
- {id: emlib_vcmp}
- instance: [btn0, btn1]
  id: simple_button
- {id: sl_string}
- {id: sl_system}
- {id: udelay}
define:
- {name: DEBUG_EFM}
ui_hints:
  highlight:
  - {path: readme.md, focus: true}

